<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows7.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dreamine.Identity</RootNamespace>
    <Description>Dreamine 계열 앱에서 공유하는 OAuth 로그인, User 저장소, 인증 엔드포인트 라이브러리.</Description>
    <PackageId>Dreamine.Identity</PackageId>
    <Version>1.0.1</Version>
    <Authors>Dreamine Core Team</Authors>
    <Company>CodeMaru-Dreamine</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Identity</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Identity</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dreamine;identity;authentication;oauth;sqlite;blazor;wpf</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Database.Abstractions\Dreamine.Database.Abstractions.csproj" />
    <ProjectReference Include="..\Database.Core\Dreamine.Database.Core.csproj" />
    <ProjectReference Include="..\Database.Sqlite\Dreamine.Database.Sqlite.csproj" />
    <ProjectReference Include="..\Hybrid.Wpf\Dreamine.Hybrid.Wpf.csproj" Condition="'$(TargetFramework)' == 'net8.0-windows7.0'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="AspNet.Security.OAuth.Naver" />
    <PackageReference Include="AspNet.Security.OAuth.KakaoTalk" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
